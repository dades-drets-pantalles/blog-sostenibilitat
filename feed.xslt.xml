<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:atom="http://www.w3.org/2005/Atom">
<xsl:output method="html" encoding="utf-8" indent="yes"/>
<xsl:template match="/">
<html lang="ca">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>RSS · <xsl:value-of select="atom:feed/atom:title"/></title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #0b0b24; color: #ecebff; font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
    .wrap { max-width: 46rem; margin: 0 auto; padding: 2.5rem 16px 4rem; }
    .mono { font-family: ui-monospace, Menlo, monospace; }
    .kicker { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: #60a5fa; margin: 0; }
    h1 { font-size: 2.2rem; line-height: 1.1; margin: .5rem 0 1rem; }
    .box { background: #15153d; border: 1px solid #2a2a5e; border-left: 3px solid #a78bfa; border-radius: 8px; padding: 1rem 1.2rem; margin: 0 0 2rem; color: #a3a3cc; }
    .box strong { color: #ecebff; }
    code { background: #1b1b4a; padding: .15em .4em; border-radius: 4px; color: #c4b5fd; word-break: break-all; }
    a { color: #c4b5fd; }
    ul { list-style: none; padding: 0; margin: 0; }
    li { border-bottom: 1px solid #2a2a5e; padding: 1rem 0; }
    li a { color: #ecebff; text-decoration: none; font-weight: 600; font-size: 1.08rem; }
    li a:hover { color: #c4b5fd; }
    .meta { font-size: .75rem; color: #7474a8; margin-top: .25rem; }
    .back { display: inline-block; margin-top: 2rem; font-size: .85rem; }
  </style>
</head>
<body>
  <div class="wrap">
    <p class="kicker mono">// Feed RSS</p>
    <h1><xsl:value-of select="atom:feed/atom:title"/></h1>
    <div class="box">
      <p style="margin-top:0"><strong>Això és un feed RSS.</strong> Serveix per rebre les entrades noves automàticament en una app de lectura (Feedly, Inoreader, NetNewsWire, Thunderbird…).</p>
      <p style="margin-bottom:0">Copia aquesta adreça i enganxa-la a la teva app:<br/><code><xsl:value-of select="atom:feed/atom:link[@rel='self']/@href"/></code></p>
    </div>
    <ul>
      <xsl:for-each select="atom:feed/atom:entry">
        <li>
          <a href="{atom:link[@rel='alternate']/@href}"><xsl:value-of select="atom:title"/></a>
          <div class="meta mono"><xsl:value-of select="atom:author/atom:name"/></div>
        </li>
      </xsl:for-each>
    </ul>
    <a class="back mono" href="{atom:feed/atom:link[@rel='alternate']/@href}">← Torna al blog</a>
  </div>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
